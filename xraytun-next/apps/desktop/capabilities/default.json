{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "xraytun-next 主窗口的最小权限集：只给窗口基本操作与事件监听。应用自己定义的桥命令 xt_daemon_request 不经过 ACL —— Tauri 的 ACL 只约束插件命令。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:event:default"
  ]
}
