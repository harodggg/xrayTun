{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XrayTun",
  "version": "0.8.40",
  "identifier": "com.xraytun.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "XrayTun",
        "width": 1080,
        "height": 720,
        "minWidth": 900,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Utility",
    "shortDescription": "基于 Xray 内核、支持 TUN 模式的 macOS 代理客户端",
    "longDescription": "XrayTun 使用 Xray-core 原生 TUN 入站接管系统流量，通过特权 helper 完成 utun 创建、路由与 DNS 配置，并保证任何时刻都能完整回滚。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": {
      "binaries/xray": "xray",
      "binaries/geoip.dat": "geoip.dat",
      "binaries/geosite.dat": "geosite.dat",
      "../../scripts/incident-bundle.sh": "scripts/incident-bundle.sh",
      "../../scripts/triage-incident.py": "scripts/triage-incident.py",
      "../../scripts/net-metrics.py": "scripts/net-metrics.py"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist",
      "frameworks": []
    }
  }
}
