{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XrayTun Next",
  "version": "1.0.0",
  "identifier": "com.xraytun.next",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "XrayTun Next",
        "width": 1080,
        "height": 720,
        "minWidth": 900,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Utility",
    "shortDescription": "xraytun-next 桌面壳：菜单栏 + 主窗口 + daemon IPC 桥",
    "longDescription": "XrayTun Next 是一个薄壳：daemon（xt-daemon，普通用户进程）持有全部业务与数据面，界面通过本机 AF_UNIX 契约帧与它通信。壳只负责拉起 daemon、承载界面、提供菜单栏，并转发这条桥。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}